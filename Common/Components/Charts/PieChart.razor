@using Common.Components.Bases
@using Common.Enumerations
@using Common.Extensions
@using Common.Models.Charts
@using Common.Models.General
@using Microsoft.AspNetCore.Components.Web
@inherits SelectableBase<SliceModel>

<figure class=@_builder.Add("common__piechart mx-2")>
    <div class="common__piechart__content wrap full-center">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="-1 -1 2 2">
            @foreach (var item in Templates)
            {
                <Slice Model=item Multiplier=Multiplier OnActivated=@(() => Update(item)) OnChanged=SetTip />
            }
        </svg>

        <div class="common__piechart__legend column">
            @foreach (var item in Templates)
            {
                <p>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2 1" data-color=@item.Color?.Var><path d="M 0 0 L 0 1 L 2 1 L 2 0 Z" /></svg>
                    @* <span data-color=@item.Color?.Var><Icon Content=@IconPath.Rectangle /></span> *@
                    @item.Title
                </p>
            }
        </div>

        <div class="common__tooltip__text" opaque=@(Slice is null) style=@Style>@($"{Slice?.Title} : {Slice?.Count / Slice?.Total:0.##%}")</div>
    </div>


    @if ((SelectedItem?.Description ?? Description) is string description)
    {
        <div class="common__piechart__description mx-3">
            @(new MarkupString(description))
        </div>
    }

    <figcaption class="h4">@Caption</figcaption>
</figure>

@code {
    [Parameter, EditorRequired]
    public string Caption { get; set; }
    [Parameter]
    public string? Description { get; set; }
    [Parameter]
    public double? Multiplier { get; set; }

    private SliceModel? Slice { get; set; }
    private string? Style { get; set; }

    private void SetTip(TipEventArgs<SliceModel>? args)
    {
        Slice = args?.Model;
        Style = args?.Style;
    }
}

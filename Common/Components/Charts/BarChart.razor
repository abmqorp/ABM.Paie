@using Common.Components.Bases
@using Common.Models.Charts
@using Microsoft.AspNetCore.Components.Web
@inherits SelectableBase<BarModel>

<figure class=@_builder.Add("common__barchart my-5")>
    <figcaption Class="h3">@Caption</figcaption>
    <div class="common__barchart__content" data-cols=@Templates.Count()>
        @foreach (var ordinate in Ordinates)
        {
            <div class="common__barchart__axes" ordinate=@(ordinate - 1)><span>@ordinate</span></div>
        }
    
        @foreach (var item in Templates)
        {
            <Tooltip count=@item.Count selected=@item.IsSelected Content=@($"{item.Title} : {item.Count:0.##}") 
                OnActivated=@(() => Update(item))>
                <span>@item.Title</span>
            </Tooltip>
        }
    </div>
    @if (SelectedItem?.Description is string description)
    {
        <div class="common__barchart__description mx-3">
            @description
        </div>
    }
</figure>

@code {
    [Parameter, EditorRequired]
    public string Caption { get; set; }
    [Parameter]
    public IEnumerable<int> Ordinates { get; set; } = Enumerable.Range(0, 6).Select(i => i * 20);
}

@using Common.Components.Bases
@using Common.Enumerations
@using Common.Extensions
@using Common.Models.Charts
@using Microsoft.AspNetCore.Components.Web
@inherits SelectableBase<BarModel>

<figure class=@_builder.Add("common__barchart mx-2")>
    <figcaption class="h4">@Caption</figcaption>

    <div class="common__barchart__content" data-cols=@Templates.Count()>
        @foreach (var ordinate in Ordinates)
        {
            <div class="common__barchart__axes" data-ordinate=@ordinate data-max=@Max><span>@ordinate</span></div>
        }

        @foreach (var item in Templates)
        {
            <Tooltip data-count=@item.Count data-max=@Max selected=@item.IsSelected data-color=@((item.IsSelected? Color.Primary: item.Color ?? Color.Gray).Var)
                Model=@($"{item.Title} : {item.Count:0.##}") OnActivated=@(() => Update(item))>
                @item.Title
            </Tooltip>
        }
    </div>

    @if ((SelectedItem?.Description ?? Description) is string description)
    {
        <div class="common__barchart__description mx-3">
            @(new MarkupString(description))
        </div>
    }
</figure>

    @code {
    [Parameter, EditorRequired]
    public string Caption { get; set; }
    [Parameter]
    public string? Description { get; set; }
    [Parameter]
    public int Max { get; set; } = 100;
    [Parameter]
    public IEnumerable<int> Ordinates { get; set; } = Enumerable.Range(0, 6).Select(i => i * 20);
}

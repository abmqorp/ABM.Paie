@using System.Timers
@using Common.Components.Bases
@using Common.Enumerations
@using Common.Extensions
@using Common.Models
@using Microsoft.AspNetCore.Components.Web
@typeparam T
@inherits Base
@implements IDisposable

<div class=@_builder.Add("common__carousel")>
    @if (!_isDisabled)
    {
        <button type="button" class="left" label="Suivant" @onclick=Previous>
            <Icon Content=@IconPath.ArrowBackIosNew />
        </button>
    }
    @for (Position = 0; Position < Batch; Position++) @ChildContent(Templates.ElementAtOrDefault(GetIndex()))
    @if (!_isDisabled)
    {
        <button type="button" class="right" aria-label="Suivant" @onclick=Next>
            <Icon Content=@IconPath.ArrowForwardIos />
        </button>
    }
</div>

@code {
    private const int SecondsToMilliseconds = 1000;

    [Parameter, EditorRequired]
    public IEnumerable<T?> Templates { get; set; }
    [Parameter, EditorRequired]
    public RenderFragment<T?> ChildContent { get; set; }
    [Parameter]
    public int? Interval { get; set; } = 10;
    [Parameter]
    public int Batch { get; set; } = 1;

    private int Index { get; set; } = 0;
    private int Position { get; set; } = 0;

    private Timer? _timer;
    private int _count;
    private bool _isDisabled;

    protected override void OnInitialized()
    {
        _count = Templates.Count();
        _isDisabled = _count <= Batch;

        if (_isDisabled) Batch = _count;

        if (Templates.Any() && !_isDisabled && Interval.HasValue)
        {
            _timer = new(Interval.Value * SecondsToMilliseconds);
            _timer.Elapsed += OnTimedEvent;
            _timer.AutoReset = true;
            _timer.Start();
        }

        base.OnInitialized();
    }

    private void OnTimedEvent(object? sender, ElapsedEventArgs args)
    {
        SetCurrent();
        StateHasChanged();
    }

    private void Previous()
    {
        SetCurrent(false);
        _timer?.Reset();
    }

    private void Next()
    {
        SetCurrent();
        _timer?.Reset();
    }

    private void SetCurrent(bool isNext = true)
    {
        if (_count > 0)
        {
            Position = 0;
            Index = GetIndex(isNext);
        }
    }

    private int GetIndex(bool isNext = true)
    {
        return (Index + Position + (isNext ? 1 : _count - 1)) % _count;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}

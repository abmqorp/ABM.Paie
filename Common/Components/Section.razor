@using Common.Components.Bases
@using Common.Enumerations
@using Common.Models
@inherits Base

@SetSection()

@code {
    [Parameter, EditorRequired]
    public UriModel Model { get; set; }
    [Parameter]
    public SectionLevel Level { get; set; } = SectionLevel.H1;

    private RenderFragment? SetSection()
    {
        var tag = Level.ToString().ToLower();
        return @: @((MarkupString)$"<{tag} id={Model.Id} class={_builder.Add("common__section")}>{Model.Content}</{tag}>")
        ;
    }
}

@using System.ComponentModel
@using Common.Components.Bases
@using Common.Enumerations
@using Common.Extensions
@inherits Base

@if (Content is not null)
{
    <svg class=@_builder.Add("common__icon") xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960">
        <path d=@Content.Description />
    </svg>
}

@code {
    [Parameter, EditorRequired]
    public IconPath? Content { get; set; }
}

@using System.Threading.Tasks
@using Common.Components.Bases
@using Microsoft.AspNetCore.Components.Web
@inherits TooltipBase<string>

<button class=@_builder.Add("common__tooltip") type="button"
    @attributes=AdditionalAttributes
    @onmouseover=Show @onmouseout=Hide @onmousemove=Update
    @onfocusin=Show @onfocusout=Hide
    @onclick=Activate>
    @ChildContent
    <div class="common__tooltip__text" opaque=@IsOpaque style=@Style>@Content</div>
</button>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter]
    public RenderFragment? ChildContent {get; set;}

    private bool IsOpaque { get; set; } = true;

    protected override void Change(TipEventArgs<string>? args) => IsOpaque = args is null;
}

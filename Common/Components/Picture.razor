@using Common.Components.Bases
@using Common.Models
@inherits Base

<div class=@_builder.Add("common__picture")>
    <Image Model=Model />
    <div class="common__picture__signature">
        <Image Model=Signature />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ImageModel Model { get; set; }
    [Parameter]
    public ImageModel? Signature { get; set; }
}

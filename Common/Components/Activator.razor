@using Common.Components.Bases
@using Common.Models
@inherits BaseTemp

<div class=@_builder.Add("common__activator", Model.Class)>
    <div><Icon Content=Model.StartIcon /></div>
    @if (ChildContent is not null)
    {
        <div class="common__activator__content">@ChildContent</div>
    }
    <div><Icon Content=Model.EndIcon /></div>
</div>

@code {
    [Parameter, EditorRequired]
    public ActivatorModel Model { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

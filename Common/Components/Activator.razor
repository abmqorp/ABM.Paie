@using Common.Components.Bases
@using Common.Enumerations
@using Common.Models
@inherits Base

<div class=@_builder.Add("common__activator", Model.Class)>
    <Icon Content=Model.StartIcon />
    @if (ChildContent is not null)
    {
        <span class="common__activator__content">@ChildContent</span>
    }
    <Icon Content=Model.EndIcon />
</div>

@code {
    [Parameter, EditorRequired]
    public ActivatorModel Model { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

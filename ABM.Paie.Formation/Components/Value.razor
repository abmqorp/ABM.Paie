@using ABM.Paie.Formation.Components
@using ABM.Paie.Formation.Models
@using Common.Components
@using Common.Components.Bases
@inherits Base

<div class=@_builder.Add("abm__value")>
    @for (var i = 0; i < Size; i++)
    {
        if (i + 1 == Model.Position)
        {
            <div><Paragraph Class="bold large">@Model.Word</Paragraph></div>
        }
        else
        {
            <div />
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ValueModel Model { get; set; }
    [Parameter, EditorRequired]
    public int Size { get; set; }
}

@page "/formations"
@using Common.Graphics.Enumerations
@using Common.Graphics.Svg.Enumerations
@using Common.Graphics.Svg.Extensions
@using Common.Graphics.Svg.Models
@using static Common.Graphics.Models.Property

<h2>Les déclarations sociales</h2>

@{
    var top = new List<(string Text, Icon Icon, Color? Color)>()
    {
        new("SALARIÉ", Icon.Person, null), new("DÉCLARANT", Icon.Domain, null),
        new("DÉCLARATION", Icon.Computer, Color.Primary), new("RETOURS", Icon.Mail, null),
    };

    var svg = new Container(new(0, 0, 1000, 640), true) { Fill = Color.GrayDark }.Add(
        new Group() { TextAnchor = Anchor.Middle, FontSize = new(9) }.AddRange(
            top.Select((t, i) => 
                new Container(ViewBox.Icon){ X = new(150 * i), Y = new(0), Width = new(15), Height = new(20), Fill = t.Color }.AddRange([
                    new Text(t.Text, new(50, Unit.Percent), new(-82.5, Unit.Percent)),
                    new Path(t.Icon) { Transform = new Transform().Scale(0.5).Translate(new(480, -560)) },
                ])
            )
        )
    ).Add(
        new Group() { Stroke = Color.GrayDark }.AddRange(Enumerable.Range(1, 3)
            .Select(r => new Line(new(150 * r), new(150 * r), new(80), new(592)))
        )
    ).Add(
        new Group() { Fill = Color.White, FontSize = new(1.25) }.AddRange([
            new Rect(new(600), new(32), new(35), new(9)) { Fill = Color.Primary, Opacity = new(0.75) },
            new Rect(new(600), new(89.6), new(35), new(27)) { Fill = Color.Primary, Opacity = new(0.40) },
            new Text("Dépôt de la DSN", new(650), new(134.4)),
            new Container(ViewBox.Icon) { X = new(630), Y = new(131.2), Width = new(10), Height = new(10) }.Add(
                new Path(Icon.Cancel) { Transform = new Transform().Scale(0.5) }
            ),
            new Text("Rejet", new(685), new(185.6)),
            new Container(ViewBox.Icon) { X = new(630), Y = new(182.4), Width = new(10), Height = new(10) }.Add(
                new Path(Icon.CheckCircle) { Transform = new Transform().Scale(0.5) }
            ),
            new Text("Acceptation", new(685), new(236.8)),
            new Text("PLATEFORMES DE DÉPÔT", new(620), new(70.4)) { FontSize = new(1.5) },
        ])
    );
}


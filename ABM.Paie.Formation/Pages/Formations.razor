@page "/formations"
@using Common.Graphics.Enumerations
@using Common.Graphics.Svg.Enumerations
@using Common.Graphics.Svg.Models
@using static Common.Graphics.Models.Property

<h2>Les déclarations sociales</h2>

@{
    var top = new List<(string Text, Icon Icon, Color? Color)>()
    {
        new("SALARIÉ", Icon.Person, null), new("DÉCLARANT", Icon.Domain, null),
        new("DÉCLARATION", Icon.Computer, Color.Primary), new("RETOURS", Icon.Mail, null),
    };
    var topGroup = new Group() { TextAnchor = Anchor.Middle, FontSize = 9 }.AddRange(
        top.Select((t, i) =>
            new Container(ViewBox.Icon) { X = 150 * i, Y = 0, Width = 15, Height = 20, Fill = t.Color }.AddRange([
                new Text(t.Text, 480, -792),
                new Path(t.Icon) { Transform = new Scale(0.5).Translate(new(480, -560)) },
            ])
        )
    );

    var axes = new Group() { Stroke = Color.GrayDark }.AddRange(
        Enumerable.Range(1, 3).Select(r => new Line(150 * r, 150 * r, 80, 592))
    );

    var plateforms = new Group() { Fill = Color.White, FontSize = 1.25 }.AddRange([
        new Rect(600, 32, 35, 9) { Fill = Color.Primary, Opacity = 0.75, Tooltip = @<div>toto</div> },
        new Rect(600, 89.6, 35, 27) { Fill = Color.Primary, Opacity = 0.40 },
        new Text("Dépôt de la DSN", 650, 134.4),
        new Container(ViewBox.Icon) { X = 630, Y = 131.2, Width = 10, Height = 10 }.Add(
            new Path(Icon.Cancel) { Transform = new Scale(0.5) }
        ),
        new Text("Rejet", 685, 185.6),
        new Container(ViewBox.Icon) { X = 630, Y = 182.4, Width = 10, Height = 10 }.Add(
            new Path(Icon.CheckCircle) { Transform = new Scale(0.5) }
        ),
        new Text("Acceptation", 685, 236.8),
        new Text("PLATEFORMES DE DÉPÔT", 620, 70.4) { FontSize = 1.5 },
    ]);

    var controls = new List<(string Text, double XText, Icon Icon, double XIcon)>()
    {
        new("BLOQUANTS :", 660, Icon.Cancel, 731.25), new("NON BLOQUANTS :", 782.5, Icon.BuildCircle, 887.5), new("OK :", 940, Icon.CheckCircle, 950)
    };
    var analyses = new List<List<(Icon Icon, Color? Color)>>()
    {
        new([new(Icon.Cancel, null), new(Icon.BuildCircle, null)]),
        new([new(Icon.Cancel, null), new(Icon.BuildCircle, null), new(Icon.CheckCircle, null)]),
        new([new(Icon.BuildCircle, null)]),
        new([new(Icon.BuildCircle, Color.PrimaryDark), new(Icon.CheckCircle, Color.PrimaryDark)]),
    };
    var organisms = new Group() { Fill = Color.White }.AddRange([
        new Rect(650, 278.4, 35, 47.5) { Fill = Color.GrayDark, Opacity = 0.4 },
        new Rect(650, 582.4, 35, 9) { Fill = Color.GrayDark, Opacity = 0.75 },
        new Text("Analyse - contrôles :", 700, 310.4) { FontSize = 1.25 },
        new Group() { FontSize = 0.8 }.AddRange(controls.Select(c => new Text(c.Text, new(c.XText), 342.4))),
    ]).AddRange(
        controls.Select(c => new Container(ViewBox.Icon) { X = new(c.XIcon), Y = 284.8, Width = 10, Height = 10 }.Add(
            new Path(c.Icon) { Transform = new Scale(0.33) }
        ))
    ).AddRange(
        analyses.SelectMany((a, i) => a.Select((c, j) => 
            new Container(ViewBox.Icon) { X = 680 + 50 * j, Y = 348.8 + i * 51.2, Width = 10, Height = 10, Fill = c.Color }.Add(
                new Path(c.Icon) { Transform = new Scale(0.75) })))
    ).AddRange([
        new Text("(si signalements)", 800, 550.4) { Fill = Color.PrimaryDark, FontSize = 1.25 },
        new Text("ORGANISMES", 750, 620.8) { FontSize = 1.5 },
    ]);

    var svg = new Container(new(0, 0, 1000, 640), true) { Fill = Color.GrayDark }
        .Add(topGroup).Add(axes).Add(plateforms).Add(organisms).AddRange([
            new Group() { Stroke = Color.Primary, StrokeWidth = new(5), StrokeLineCap = LineCap.Round }.AddRange(
                [new Line(225, 630, 128, 128), new Line(610, 630, 120, 128), new Line(610, 630, 136, 128)]
            ),

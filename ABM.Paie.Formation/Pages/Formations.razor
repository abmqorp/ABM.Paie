                new Rect(240, -672, 50, 40) { Fill = Color.White },
                new Text("CCO", 480, -144) { TextAnchor = Anchor.Middle, FontSize = 8 },
                new Path(Icon.License) { Transform = new Scale(0.5).Translate(new(480, -480)) },
            ]),
            new Container(ViewBox.Icon) { X = 480, Y = 166.4, Width = 15, Height = 20, Fill = Color.Success }.AddRange([
                new Rect(240, -672, 50, 40) { Fill = Color.White },
                new Text("AEE", 480, -144) { TextAnchor = Anchor.Middle, FontSize = 8 },
                new Path(Icon.Mail) { Transform = new Scale(0.5).Translate(new(480, -480)) },
            ]),
        ]).AddRange([
            new Group() { Stroke = Color.Danger, StrokeWidth = new(5), StrokeLineCap = LineCap.Round }.AddRange(
                [new Line(225, 685, 390.4, 390.4), new Line(225, 245, 390.4, 382.4), new Line(225, 245, 390.4, 398.4)]
            ),
            new Container(ViewBox.Icon) { X = 450, Y = 326.4, Width = 15, Height = 20, Fill = Color.Danger }.AddRange([
                new Rect(240, -672, 50, 40) { Fill = Color.White },
                new Text("BAN", 480, -369.6) { TextAnchor = Anchor.Middle, FontSize = 8 },
                new Path(Icon.Mail) { Transform = new Scale(0.5).Translate(new(480, -480)) },
            ]),
        ]).AddRange([
            new Group() { Stroke = Color.GrayDark, StrokeWidth = new(5), StrokeLineCap = LineCap.Round }.AddRange(
                [new Line(225, 685, 441.6, 441.6), new Line(225, 245, 441.6, 433.6), new Line(225, 245, 441.6, 449.6)]
            ),
            new Container(ViewBox.Icon) { X = 450, Y = 377.6, Width = 15, Height = 20, Fill = Color.GrayDark }.AddRange([
                new Rect(240, -672, 50, 40) { Fill = Color.White },
                new Text("CRM", 480, -369.6) { TextAnchor = Anchor.Middle, FontSize = 8 },
                new Path(Icon.Mail) { Transform = new Scale(0.5).Translate(new(480, -480)) },
            ]),
        ]).AddRange([
            new Group() { Stroke = Color.PrimaryDark, StrokeWidth = new(5), StrokeLineCap = LineCap.Round }.AddRange(
                [new Line(225, 685, 492.8, 492.8), new Line(225, 245, 492.8, 484.8), new Line(225, 245, 492.8, 500.8)]
            ),
            new Container(ViewBox.Icon) { X = 300, Y = 428.8, Width = 15, Height = 20, Fill = Color.PrimaryDark }.AddRange([
                new Rect(240, -672, 50, 40) { Fill = Color.White },
                new Path(Icon.Computer) { Transform = new Scale(0.5).Translate(new(480, -480)) },
                new Path(Icon.ChangeCircle) { Transform = new Scale(0.25).Translate(new(1440, -1560)) },

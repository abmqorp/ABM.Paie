    var dsnSub = new Container(ViewBox.Icon) { X = 300, Y = 428.8, Width = 15, Height = 20, Fill = Color.PrimaryDark }.AddRange([
        new Rect(240, -672, 50, 40) { Fill = Color.White },
        new Path(Icon.Computer) { Transform = new Scale(0.5).Translate(new(480, -480)) },
        new Path(Icon.ChangeCircle) { Transform = new Scale(0.25).Translate(new(1440, -1560)) },

            new Group() { Stroke = Color.PrimaryDark, StrokeWidth = new(5), StrokeLineCap = LineCap.Round }.AddRange(
                [new Line(225, 685, 544, 544), new Line(225, 245, 544, 536), new Line(225, 245, 544, 552)]

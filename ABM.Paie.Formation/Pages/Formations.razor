@* <Common.Graphics.Svg.Components.Container Model=svg /> *@

<Common.Graphics.Svg.Components.Container Model=@(new Container(ViewBox.Icon) { X = 300, Y = 428.8, Width = 15, Height = 20, Fill = Color.PrimaryDark })>
    <Common.Graphics.Svg.Components.Group Model=@(new Group()) Text="DSN de substitution" Position=Common.Tools.Tips.Position.Right>
        <Common.Graphics.Svg.Components.Rect Model=@(new Rect(240, -672, 50, 40) { Fill = Color.White }) />
        <Common.Graphics.Svg.Components.Path Model=@(new Path(Icon.Computer) { Transform = new Scale(0.5).Translate(new(480, -480)) }) />
        <Common.Graphics.Svg.Components.Path Model=@(new Path(Icon.ChangeCircle) { Transform = new Scale(0.25).Translate(new(1440, -1560)) }) />
    </Common.Graphics.Svg.Components.Group>
</Common.Graphics.Svg.Components.Container>


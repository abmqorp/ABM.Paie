                new Rect(240, -672, 50, 40) { Fill = Color.White },
                new Text("DSN", 480, -456) { TextAnchor = Anchor.Middle, FontSize = 8 },
                new Path(Icon.Computer) { Transform = new Scale(0.5).Translate(new(480, -480)) },
            ]),
        ]).AddRange([
            new Group() { Stroke = Color.Danger, StrokeWidth = new(5), StrokeLineCap = LineCap.Round }.AddRange(
                [new Line(225, 630, 179.2, 179.2), new Line(225, 245, 179.2, 171.2), new Line(225, 245, 179.2, 187.2)]

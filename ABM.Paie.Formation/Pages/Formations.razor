            new Container(ViewBox.Icon) { X = 450, Y = 115.2, Width = 15, Height = 20, Fill = Color.Danger }.AddRange([
                new Rect(240, -672, 50, 40) { Fill = Color.White },
                new Text("ARE", 480, -369.6) { TextAnchor = Anchor.Middle, FontSize = 8 },
                new Path(Icon.Mail) { Transform = new Scale(0.5).Translate(new(480, -480)) },
            ]),

            new Group() { Stroke = Color.Success, StrokeWidth = new(5), StrokeLineCap = LineCap.Round }.AddRange([
                new Line(225, 630, 230.4, 230.4), new Line(225, 245, 230.4, 222.4), new Line(225, 245, 230.4, 238.4),
